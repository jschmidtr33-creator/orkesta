# Copia este archivo a apps/api/.env para desarrollo local. Nunca subas secretos al repositorio.
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres@localhost:5432/orkesta
SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:8000
# Inicio de sesión con Google (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Primer administrador de la plataforma (se crea en `python -m orkesta.cli release`)
ORKESTA_BOOTSTRAP_ADMIN_EMAIL=
ORKESTA_BOOTSTRAP_ADMIN_PASSWORD=
ORKESTA_BOOTSTRAP_ORG_NAME=Mi empresa
