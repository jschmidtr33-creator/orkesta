# Copia este archivo como .env para desarrollo local. Nunca subas .env al repositorio.
# En Railway estas variables se definen en cada servicio (ver .railway/railway.ts).

# development | test | staging | production
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# URL de PostgreSQL. En Railway se toma del servicio PostgreSQL automáticamente.
DATABASE_URL=postgresql://postgres@localhost:5432/orkesta_dev

# Obligatoria en staging y producción, mínimo 32 caracteres. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Conexiones de la base por proceso
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# Worker y cola de trabajos
WORKER_POLL_INTERVAL_SECONDS=2
# Un trabajo en curso sin señales durante este tiempo se considera abandonado y se reanuda
JOB_LOCK_TIMEOUT_SECONDS=600
# Reintentos con espera exponencial: base, 2×base, 4×base... hasta el máximo
JOB_RETRY_BASE_SECONDS=30
JOB_RETRY_MAX_SECONDS=3600
JOB_DEFAULT_MAX_ATTEMPTS=3

# Solo para las pruebas: servidor donde el usuario puede crear bases temporales
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/postgres
