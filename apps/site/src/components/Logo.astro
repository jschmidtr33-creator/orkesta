---
interface Props {
  size?: number;
  id?: string;
}
const { size = 30 } = Astro.props;
---

<span class="inline-flex items-center gap-2.5" role="img" aria-label="ORKESTA">
  <img src="/logo-mark.svg" alt="" width={size} height={Math.round(size * 0.9)} />
  <span
    aria-hidden="true"
    class="font-medium tracking-[0.2em] text-white"
    style={`font-size:${Math.round(size * 0.62)}px;font-family:'Avenir Next',Avenir,Montserrat,'Century Gothic','Segoe UI',sans-serif`}
  >ORKESTΛ</span>
</span>
