---
import Logo from "../components/Logo.astro";
import Base from "../layouts/Base.astro";

// Pantallas reales de ORKESTA con un ejemplo ficticio (Nexa Logística).
const tour = [
  { key: "ingresar", tag: "Ingresa", title: "Entras con tu cuenta de Google o tu correo", text: "Cada empresa tiene su propio espacio de trabajo, aislado y seguro." },
  { key: "inicio", tag: "Tu día", title: "Lo primero que ves: tus pendientes y las novedades", text: "Tareas de hoy, vencidas, quién respondió y quién abrió tu propuesta." },
  { key: "prospeccion", tag: "Prospecta", title: "Encuentra decisores con filtros inteligentes", text: "Cargo, función, sector y país. Cada lead con su correo, LinkedIn y un puntaje de encaje." },
  { key: "campana", tag: "Contacta", title: "Campañas desde tu propio buzón, con pruebas A/B", text: "Secuencias que se detienen solas cuando responden y aprenden qué versión funciona mejor." },
  { key: "respuestas", tag: "Responden", title: "La IA lee cada respuesta y actúa por ti", text: "Quiere reunión, pide información, más adelante, no interesado: oportunidad y tarea creadas solas." },
  { key: "crm", tag: "CRM", title: "Pipeline en Kanban con la salud de cada oportunidad", text: "Caliente, tibia o fría según actividad, respuestas y propuesta vista." },
  { key: "tareas", tag: "Seguimiento", title: "Ninguna tarea se te escapa", text: "Recordatorios, vencidas y próximas, conectadas a cada contacto y oportunidad." },
  { key: "pronostico", tag: "Pronóstico", title: "Sabe cuánto vas a cerrar este mes", text: "Pronóstico ponderado con probabilidades que aprende de tus ventas y atribución por campaña." },
  { key: "automatizacion", tag: "Automatiza", title: "Reglas que trabajan solas", text: "Respondió → oportunidad y tarea. Abrió la propuesta → seguimiento en 24 h. Ganado → onboarding." },
  { key: "propuesta", tag: "Cierra", title: "Propuestas con tu marca y firma electrónica", text: "Tu cliente firma desde el celular; recibes la constancia en PDF con su huella digital." },
];
const flow = [
  ["Prospecta", "Define tu cliente ideal y ORKESTA encuentra a los decisores con correo verificado."],
  ["Contacta", "Concertino redacta la secuencia por cargo e industria y la lanzas desde tu Gmail o Microsoft 365, a un equipo entero o a un solo contacto."],
  ["Responden", "Cada respuesta se clasifica sola y crea la oportunidad con su tarea. ¿Objeción? Concertino te dice cómo responderla."],
  ["Da seguimiento", "El CRM te dice qué oportunidades están frías y qué hacer hoy."],
  ["Propone", "Propuestas con tu logo y tus plantillas en minutos; ves cuándo la abren."],
  ["Cierra", "Firma electrónica, pronóstico y atribución: sabes qué campaña te trajo cada venta."],
];
const modules = [
  { title: "Concertino, tu asesor de ventas", text: "Un vendedor senior con IA propia: conversa, redacta correos y secuencias, maneja objeciones y conoce tu producto.", icon: '<path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>' },
  { title: "Prospección con IA propia", text: "Directorio de empresas, índice de decisores y correos que aprenden de cada campaña.", icon: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/><path d="M11 8v3l2 2"/>' },
  { title: "Correos que no rebotan", text: "Formato por empresa y por país, verificación previa y aprendizaje de rebotes.", icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>' },
  { title: "Campañas que aprenden", text: "Pruebas A/B con ganadora automática, campañas a un solo contacto y envío parejo para que ninguna se detenga.", icon: '<path d="M22 2 11 13"/><path d="M22 2 15 22l-4-9-9-4z"/>' },
  { title: "Plantillas tuyas y del equipo", text: "Guarda campañas y propuestas solo para ti o compártelas: el equipo las elige de una galería y las ajusta.", icon: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><path d="M17.5 14v7M14 17.5h7"/>' },
  { title: "CRM inteligente", text: "Salud de cada oportunidad, tareas, pronóstico de cierre y atribución por campaña.", icon: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M8 7v8M12 7v5M16 7v10"/>' },
  { title: "Propuestas con tu marca", text: "Tu logo en cada propuesta y en ORKESTA, seguimiento de lectura y firma electrónica con constancia PDF.", icon: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/>' },
  { title: "Equipos con jefaturas", text: "Cada vendedor trabaja lo suyo; la jefatura ve el resumen de su equipo sin tocar nada.", icon: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><circle cx="17.5" cy="9" r="2.5"/><path d="M16 14.5a5 5 0 0 1 5.5 5"/>' },
  { title: "Automatizaciones", text: "Recetas listas y reglas propias que trabajan en segundo plano por tu equipo.", icon: '<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8z"/>' },
];
const ribbon = ["Concertino", "Google Workspace", "Gmail", "Microsoft 365", "Outlook", "Correo corporativo", "Pruebas A/B", "Plantillas de equipo", "Campañas 1 a 1", "Firma electrónica", "Contactos privados", "Modo oscuro", "Pronóstico de cierre", "Índice de decisores", "Ley 1581 y RGPD"];
const concertino = [
  ["Conversa contigo", "Te saluda por tu nombre, sigue el hilo y te propone cómo seguir. Pregúntale como le preguntarías a un colega."],
  ["Redacta por ti", "Correos y secuencias por cargo e industria, mensajes de WhatsApp y LinkedIn, asuntos, resumen ejecutivo y guion de llamada."],
  ["Maneja objeciones", "Reconoce la objeción real detrás de lo que dijo el cliente y te da la respuesta de tu equipo y otros enfoques."],
  ["Conoce tu producto", "Aprende de la ficha de tu empresa y de tus campañas. Nunca inventa precios ni clientes."],
];
---

<Base
  title="ORKESTA · Conecta. Enriquece. Conquista."
  description="Plataforma de automatización comercial B2B: prospección, campañas, CRM, propuestas con firma electrónica y Concertino, un asesor de ventas con IA propia que redacta y aconseja."
>
  <header class="sticky top-0 z-30 border-b border-white/5 bg-ork-ink/70 backdrop-blur-xl">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
      <a href="/" aria-label="ORKESTA, inicio"><Logo size={28} /></a>
      <nav class="hidden items-center gap-7 text-[14px] text-ork-mist md:flex" aria-label="Secciones">
        <a href="#recorrido" class="hover:text-white">Recorrido</a>
        <a href="#proceso" class="hover:text-white">Tu proceso</a>
        <a href="#concertino" class="hover:text-white">Concertino</a>
        <a href="#modulos" class="hover:text-white">Producto</a>
        <a href="#seguridad" class="hover:text-white">Seguridad</a>
      </nav>
      <div class="flex items-center gap-3">
        <a href="/app/ingresar" class="hidden text-[14px] font-medium text-white/80 hover:text-white sm:inline">Iniciar sesión</a>
        <a href="#demo" class="ork-gradient rounded-xl px-4 py-2 text-[14px] font-semibold text-white shadow-[0_6px_20px_rgb(79_70_229/0.35)] hover:brightness-110">Solicitar demo</a>
      </div>
    </div>
  </header>

  <main>
    <section id="hero" class="relative overflow-hidden">
      <div class="aurora" aria-hidden="true"><span class="a1"></span><span class="a2"></span><span class="a3"></span></div>
      <div class="grid-bg pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="spotlight pointer-events-none absolute inset-0" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-6xl px-5 pb-16 pt-16 lg:pt-24">
        <div class="mx-auto max-w-3xl text-center" data-reveal>
          <p class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-[12.5px] font-semibold text-white/80">
            <span class="relative flex size-2"><span class="absolute inline-flex size-full animate-ping rounded-full bg-emerald-400 opacity-75"></span><span class="relative inline-flex size-2 rounded-full bg-emerald-400"></span></span>
            Automatización comercial B2B con IA propia
          </p>
          <h1 class="mt-6 text-[42px] font-bold leading-[1.05] tracking-tight sm:text-[64px]">
            Tu proceso comercial,<br /><span class="shine">de la prospección a la firma.</span>
          </h1>
          <p class="mx-auto mt-6 max-w-2xl text-[17.5px] leading-relaxed text-white/75">
            Encuentra decisores, contáctalos desde tu correo, deja que la IA lea sus respuestas, haz seguimiento en el CRM y cierra con propuestas firmadas. Con Concertino, un asesor de ventas con IA propia que redacta y te aconseja en cada paso.
          </p>
          <div class="mt-9 flex flex-wrap justify-center gap-3">
            <a href="#demo" class="ork-gradient rounded-xl px-6 py-3 text-[15px] font-semibold text-white shadow-[0_8px_28px_rgb(79_70_229/0.45)] transition hover:-translate-y-0.5 hover:brightness-110">Solicitar demo</a>
            <a href="#recorrido" class="rounded-xl border border-white/15 bg-white/[0.03] px-6 py-3 text-[15px] font-semibold text-white transition hover:-translate-y-0.5 hover:bg-white/[0.07]">Ver cómo funciona</a>
          </div>
        </div>

        <div class="relative mx-auto mt-14 max-w-5xl" data-reveal style="--delay: 150ms">
          <div class="glow-frame shadow-[0_40px_120px_rgb(0_0_0/0.6)]">
            <div class="overflow-hidden rounded-[20px] bg-ork-night">
              <div class="flex items-center gap-1.5 border-b border-white/5 bg-[#0B1020] px-4 py-2.5">
                <span class="size-2.5 rounded-full bg-[#FF5F57]"></span><span class="size-2.5 rounded-full bg-[#FEBC2E]"></span><span class="size-2.5 rounded-full bg-[#28C840]"></span>
                <span class="mx-auto rounded-md bg-white/5 px-3 py-0.5 text-[11.5px] font-semibold tracking-[0.18em] text-white/55">ORKESTA</span>
              </div>
              <video class="block aspect-[16/10] w-full bg-ork-night" autoplay muted loop playsinline preload="metadata" poster="/media/recorrido-poster.webp" aria-label="Recorrido por ORKESTA: ingreso, prospección, campañas, CRM, pronóstico, automatizaciones y propuesta firmada">
                <source src="/media/recorrido.webm" type="video/webm" />
                <source src="/media/recorrido.mp4" type="video/mp4" />
              </video>
            </div>
          </div>
          <div class="pointer-events-none absolute -left-6 top-[22%] hidden lg:block">
            <div class="toast-float float-y rounded-2xl border border-white/10 bg-[#0F152A]/90 px-4 py-3 shadow-2xl backdrop-blur" data-toast="0">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-emerald-300">Respondió · Quiere reunión</p>
              <p class="mt-0.5 text-[13.5px] font-semibold">Camila Herrera · Andes Retail</p>
            </div>
          </div>
          <div class="pointer-events-none absolute -right-8 top-[45%] hidden lg:block">
            <div class="toast-float float-y rounded-2xl border border-white/10 bg-[#0F152A]/90 px-4 py-3 shadow-2xl backdrop-blur" style="animation-delay: 1.5s" data-toast="1">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-sky-300">Oportunidad creada</p>
              <p class="mt-0.5 text-[13.5px] font-semibold">54.000 US$ · Reunión agendada</p>
            </div>
          </div>
          <div class="pointer-events-none absolute -left-4 bottom-[10%] hidden lg:block">
            <div class="toast-float float-y rounded-2xl border border-white/10 bg-[#0F152A]/90 px-4 py-3 shadow-2xl backdrop-blur" style="animation-delay: 3s" data-toast="2">
              <p class="text-[11px] font-semibold uppercase tracking-wider text-violet-300">Propuesta firmada</p>
              <p class="mt-0.5 text-[13.5px] font-semibold">Lucía Ferrer · 77.992 US$</p>
            </div>
          </div>
        </div>
        <p class="mt-4 text-center text-[12px] text-white/40">Pantallas reales de ORKESTA con datos de ejemplo ficticios.</p>
      </div>
    </section>

    <div class="overflow-hidden border-y border-white/5 bg-white/[0.02] py-4" aria-hidden="true">
      <div class="marquee gap-10 text-[14px] font-medium text-white/55">
        {[...ribbon, ...ribbon].map((r) => <span class="flex items-center gap-10 whitespace-nowrap">{r}<span class="size-1.5 rounded-full bg-ork-violet/60"></span></span>)}
      </div>
    </div>

    <section id="recorrido" class="relative py-24">
      <div class="mx-auto max-w-6xl px-5">
        <div class="max-w-2xl" data-reveal>
          <p class="text-[12.5px] font-semibold uppercase tracking-[0.2em] text-ork-violet">Recorrido</p>
          <h2 class="mt-3 text-[34px] font-bold leading-tight tracking-tight sm:text-[42px]">Así se ve tu día en ORKESTA</h2>
          <p class="mt-3 text-[16px] text-white/70">Sigue a Valentina, directora comercial de Nexa Logística (empresa ficticia), desde que ingresa hasta que su cliente firma.</p>
        </div>
        <div class="mt-10 grid gap-6 lg:grid-cols-[300px_1fr]" id="tour" data-reveal>
          <ol class="flex gap-2 overflow-x-auto pb-2 lg:flex-col lg:gap-1.5 lg:overflow-visible lg:pb-0" role="tablist" aria-label="Pasos del recorrido">
            {tour.map((t, i) => (
              <li class="shrink-0">
                <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-step={i} data-tag={t.tag}
                  class="tour-tab group relative w-[220px] overflow-hidden rounded-xl border border-white/10 bg-white/[0.02] px-4 py-2.5 text-left transition hover:bg-white/[0.05] aria-selected:border-ork-violet/50 aria-selected:bg-white/[0.07] lg:w-full">
                  <span class="text-[11px] font-semibold uppercase tracking-wider text-ork-violet">{String(i + 1).padStart(2, "0")} · {t.tag}</span>
                  <span class="mt-0.5 line-clamp-2 block text-[13px] font-semibold leading-snug text-white/85 lg:line-clamp-1">{t.title}</span>
                  <span class="progress absolute bottom-0 left-0 h-0.5 w-full bg-gradient-to-r from-ork-blue to-ork-violet"></span>
                </button>
              </li>
            ))}
          </ol>
          <div class="lg:sticky lg:top-24 lg:self-start">
            <div class="glow-frame">
              <div class="overflow-hidden rounded-[20px] bg-ork-night">
                <div class="flex items-center gap-1.5 border-b border-white/5 bg-[#0B1020] px-4 py-2.5">
                  <span class="size-2.5 rounded-full bg-[#FF5F57]"></span><span class="size-2.5 rounded-full bg-[#FEBC2E]"></span><span class="size-2.5 rounded-full bg-[#28C840]"></span>
                  <span class="mx-auto rounded-md bg-white/5 px-3 py-0.5 text-[11.5px] font-semibold tracking-[0.12em] text-white/55" id="tour-url">ORKESTA · {tour[0].tag}</span>
                </div>
                <div class="relative aspect-[16/10] w-full">
                  {tour.map((t, i) => (
                    <figure class={`slide ${i === 0 ? "active" : ""}`} data-slide={i} aria-hidden={i === 0 ? "false" : "true"}>
                      <img src={`/media/${t.key}.webp`} alt={`ORKESTA · ${t.title}`} width="1600" height="1000" loading={i < 2 ? "eager" : "lazy"} decoding="async" />
                    </figure>
                  ))}
                </div>
              </div>
            </div>
            <div class="mt-5 flex flex-wrap items-start justify-between gap-4">
              <div class="max-w-2xl">
                {tour.map((t, i) => (
                  <div class={`tour-caption ${i === 0 ? "" : "hidden"}`} data-caption={i}>
                    <p class="text-[19px] font-semibold">{t.title}</p>
                    <p class="mt-1 text-[15px] text-white/65">{t.text}</p>
                  </div>
                ))}
              </div>
              <div class="flex gap-2">
                <button type="button" id="tour-prev" class="flex size-10 items-center justify-center rounded-full border border-white/15 hover:bg-white/10" aria-label="Paso anterior">←</button>
                <button type="button" id="tour-pause" class="flex h-10 items-center justify-center rounded-full border border-white/15 px-4 text-[13px] font-semibold hover:bg-white/10" aria-label="Pausar el recorrido">Pausar</button>
                <button type="button" id="tour-next" class="flex size-10 items-center justify-center rounded-full border border-white/15 hover:bg-white/10" aria-label="Paso siguiente">→</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="proceso" class="relative overflow-hidden bg-ork-night py-24">
      <div class="ork-glow pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>
      <div class="relative mx-auto max-w-4xl px-5">
        <div class="text-center" data-reveal>
          <p class="text-[12.5px] font-semibold uppercase tracking-[0.2em] text-ork-violet">Tu proceso</p>
          <h2 class="mt-3 text-[34px] font-bold tracking-tight sm:text-[42px]">Un solo flujo, de punta a punta</h2>
        </div>
        <div class="relative mt-14" id="flow">
          <div class="absolute left-[19px] top-2 h-[calc(100%-16px)] w-0.5 bg-white/10 sm:left-1/2" aria-hidden="true">
            <div class="track-fill h-full w-full bg-gradient-to-b from-ork-blue via-ork-violet to-cyan-400"></div>
          </div>
          <ol class="flex flex-col gap-10">
            {flow.map(([title, text], i) => (
              <li class={`relative grid items-center gap-4 pl-14 sm:grid-cols-2 sm:pl-0 ${i % 2 ? "" : ""}`} data-reveal style={`--delay: ${80 * i}ms`}>
                <span class="ork-gradient absolute left-0 top-1 flex size-10 items-center justify-center rounded-full text-[15px] font-bold shadow-[0_0_0_6px_rgb(13_18_32)] sm:left-1/2 sm:-translate-x-1/2">{i + 1}</span>
                <div class={i % 2 ? "sm:col-start-2 sm:pl-12" : "sm:pr-12 sm:text-right"}>
                  <h3 class="text-[20px] font-semibold">{title}</h3>
                  <p class="mt-1 text-[15px] text-white/65">{text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section id="concertino" class="relative overflow-hidden py-24">
      <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 lg:grid-cols-[1fr_1.05fr]">
        <div data-reveal>
          <p class="text-[12.5px] font-semibold uppercase tracking-[0.2em] text-ork-violet">Nuevo · Concertino</p>
          <h2 class="mt-3 text-[34px] font-bold leading-tight tracking-tight sm:text-[42px]">Un vendedor senior a tu lado, siempre disponible</h2>
          <p class="mt-3 text-[16px] text-white/70">Como el concertino de una orquesta, el músico más experimentado, acompaña a cada vendedor. Usa IA propia: tus datos no salen de ORKESTA y solo actúa cuando se lo pides.</p>
          <ul class="mt-8 grid gap-4 sm:grid-cols-2">
            {concertino.map(([t, d], i) => (
              <li class="rounded-2xl border border-white/10 bg-white/[0.03] p-4" data-reveal style={`--delay: ${70 * i}ms`}>
                <h3 class="text-[15.5px] font-semibold">{t}</h3>
                <p class="mt-1 text-[14px] leading-relaxed text-white/65">{d}</p>
              </li>
            ))}
          </ul>
        </div>
        <div class="glow-frame" data-reveal style="--delay: 120ms">
          <div class="overflow-hidden rounded-[20px] bg-ork-night" role="img" aria-label="Ejemplo de conversación con Concertino: pide una secuencia de 3 correos para un CEO de banca y Concertino la redacta">
            <div class="flex items-center gap-3 border-b border-white/5 bg-[#0B1020] px-5 py-3.5">
              <span class="ork-gradient flex size-9 items-center justify-center rounded-xl">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
              </span>
              <div>
                <p class="text-[14.5px] font-semibold">Concertino</p>
                <p class="text-[12px] text-white/50">Tu asesor de ventas</p>
              </div>
            </div>
            <div class="space-y-4 px-5 py-5 text-[13.5px] leading-relaxed">
              <p class="rounded-2xl rounded-tl-md border border-white/10 bg-white/[0.04] px-4 py-3 text-white/85">Hola, Valentina. Conozco tu producto y lo que le funciona a tu empresa. ¿En qué te ayudo hoy?</p>
              <p class="ml-auto w-fit max-w-[85%] rounded-2xl rounded-br-md bg-[#2563EB] px-4 py-2.5 text-white">Crea la secuencia de 3 correos para un CEO de banca</p>
              <div class="rounded-2xl rounded-tl-md border border-white/10 bg-white/[0.04] px-4 py-3">
                <p class="text-white/85">Claro, Valentina. Te armé una secuencia de 3 correos para un CEO del sector financiero, con trato de usted.</p>
                <div class="mt-3 rounded-xl border border-ork-violet/30 bg-ork-violet/[0.06] p-3">
                  <p class="text-[12px] font-semibold text-white">Correo 1 · se envía primero</p>
                  <p class="mt-1 text-[12.5px] text-white/65">Buen día, Andrés: hablo seguido con líderes del sector financiero y hay un tema que se repite: integrar a nuevos proveedores sin frenar la operación…</p>
                </div>
                <p class="mt-2 text-[12px] text-white/45">+ correo 2 (3 días después) y correo 3 (4 días después)</p>
                <span class="ork-gradient mt-3 inline-flex rounded-lg px-3 py-1.5 text-[12.5px] font-semibold text-white">Crear campaña con esta secuencia</span>
                <div class="mt-3 flex flex-wrap gap-2 border-t border-white/10 pt-3">
                  {["Hazlo más corto", "Ahora para un CFO", "Pásalo a WhatsApp"].map((c) => <span class="rounded-full border border-white/15 px-3 py-1 text-[12px] font-semibold text-white/75">{c}</span>)}
                </div>
              </div>
            </div>
          </div>
          <p class="mt-3 text-center text-[12px] text-white/40">Conversación de ejemplo con datos ficticios.</p>
        </div>
      </div>
    </section>

    <section id="modulos" class="py-24">
      <div class="mx-auto max-w-6xl px-5">
        <div class="max-w-2xl" data-reveal>
          <p class="text-[12.5px] font-semibold uppercase tracking-[0.2em] text-ork-violet">Producto</p>
          <h2 class="mt-3 text-[34px] font-bold leading-tight tracking-tight">Lo que hoy contratas por separado, conectado</h2>
          <p class="mt-3 text-[16px] text-white/70">Sin duplicar registros ni saltar entre herramientas.</p>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {modules.map((m, i) => (
            <article class="card-light group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] p-6 transition duration-300 hover:-translate-y-1 hover:border-ork-violet/40" data-reveal style={`--delay: ${60 * i}ms`}>
              <span class="pointer-events-none absolute inset-0 opacity-0 transition group-hover:opacity-100" style="background: radial-gradient(400px circle at var(--cx, 50%) var(--cy, 0%), rgb(139 92 246 / 0.18), transparent 60%)"></span>
              <span class="relative inline-flex size-11 items-center justify-center rounded-xl border border-ork-violet/30 bg-ork-violet/10">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#A78BFA" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><Fragment set:html={m.icon} /></svg>
              </span>
              <h3 class="relative mt-4 text-[17px] font-semibold">{m.title}</h3>
              <p class="relative mt-1.5 text-[14.5px] leading-relaxed text-white/65">{m.text}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="seguridad" class="bg-ork-night py-24">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 lg:grid-cols-2">
        <div data-reveal>
          <h2 class="text-[34px] font-bold tracking-tight">Tus datos, protegidos y trazables</h2>
          <p class="mt-3 text-[16px] text-white/70">Construido para operar en Latinoamérica con buenas prácticas de protección de datos.</p>
        </div>
        <ul class="grid gap-4 sm:grid-cols-2">
          {[
            ["Aislamiento por empresa", "Cada espacio de trabajo está separado a nivel de base de datos."],
            ["Contactos privados", "Los contactos de cada vendedor solo los ve su dueño, y cada quien configura su correo y su firma."],
            ["IA propia, sin terceros", "Los modelos corren en ORKESTA: tus datos y los de tus clientes no viajan a otros proveedores."],
            ["Respaldos y monitoreo", "Respaldo diario fuera del servidor y alertas si el servicio deja de responder."],
            ["Bajas respetadas", "Lista de supresión automática y baja con un clic."],
            ["Ley 1581 y RGPD", "Consentimiento, oposición y salida del índice cuando se pide."],
          ].map(([t, d], i) => (
            <li class="rounded-2xl border border-white/10 p-5" data-reveal style={`--delay: ${70 * i}ms`}>
              <h3 class="text-[15.5px] font-semibold">{t}</h3>
              <p class="mt-1 text-[14px] text-white/65">{d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="demo" class="relative overflow-hidden bg-ork-night py-20">
      <div class="ork-glow pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-6xl gap-10 px-5 lg:grid-cols-[1fr_1.1fr]">
        <div>
          <h2 class="text-[32px] font-bold leading-tight tracking-tight">¿Listo para llevar tu prospección comercial al siguiente nivel?</h2>
          <p class="mt-4 text-[16px] text-white/70">Solicita una demo y te mostramos cómo ORKESTA puede ayudar a tu equipo comercial.</p>
        </div>
        <form id="demo-form" class="grid gap-4 rounded-2xl bg-white p-6 text-ork-ink shadow-[var(--shadow-pop)] sm:grid-cols-2" novalidate>
          <label class="flex flex-col gap-1.5 text-[13px] font-semibold">Nombre<input name="name" required autocomplete="name" class="ork-focus h-11 rounded-xl border border-ork-line px-3 text-[15px] font-normal" /></label>
          <label class="flex flex-col gap-1.5 text-[13px] font-semibold">Correo de trabajo<input name="email" type="email" required autocomplete="email" class="ork-focus h-11 rounded-xl border border-ork-line px-3 text-[15px] font-normal" /></label>
          <label class="flex flex-col gap-1.5 text-[13px] font-semibold">Empresa<input name="company" required autocomplete="organization" class="ork-focus h-11 rounded-xl border border-ork-line px-3 text-[15px] font-normal" /></label>
          <label class="flex flex-col gap-1.5 text-[13px] font-semibold">Cargo<input name="job_title" autocomplete="organization-title" class="ork-focus h-11 rounded-xl border border-ork-line px-3 text-[15px] font-normal" /></label>
          <label class="flex flex-col gap-1.5 text-[13px] font-semibold sm:col-span-2">País<input name="country" autocomplete="country-name" class="ork-focus h-11 rounded-xl border border-ork-line px-3 text-[15px] font-normal" /></label>
          <label class="flex flex-col gap-1.5 text-[13px] font-semibold sm:col-span-2">¿Qué te gustaría resolver? (opcional)<textarea name="message" rows="3" class="ork-focus rounded-xl border border-ork-line px-3 py-2 text-[15px] font-normal"></textarea></label>
          <label class="flex items-start gap-2.5 text-[13px] text-ork-graphite sm:col-span-2">
            <input type="checkbox" name="consent" required class="mt-0.5 size-4 accent-[#2563EB]" />
            <span>Autorizo a ORKESTA a usar estos datos para contactarme sobre la demo, según la <a href="/privacidad" class="underline">política de privacidad</a>.</span>
          </label>
          <p id="demo-status" class="text-[13.5px] sm:col-span-2" role="status" aria-live="polite"></p>
          <button type="submit" class="ork-gradient h-12 rounded-xl text-[15px] font-semibold text-white hover:brightness-110 sm:col-span-2">Solicitar demo</button>
        </form>
      </div>
    </section>
  </main>

  <footer class="border-t border-white/5 py-10">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 text-[13px] text-ork-mist">
      <Logo size={22} id="ork-logo-footer" />
      <p>Conecta. Enriquece. Conquista.</p>
      <nav class="flex gap-5" aria-label="Legal">
        <a href="/privacidad" class="hover:text-white">Privacidad</a>
        <a href="/terminos" class="hover:text-white">Términos</a>
        <a href="/app/ingresar" class="hover:text-white">Iniciar sesión</a>
      </nav>
    </div>
  </footer>
  <script src="/js/demo.js" defer is:inline></script>
  <script src="/js/landing.js" defer is:inline></script>
</Base>
