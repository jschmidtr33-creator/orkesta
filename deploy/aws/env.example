# Copia este archivo como /opt/orkesta/.env y completa los valores. Nunca lo subas a GitHub.

# Dominio público (con DNS apuntando a la IP elástica). Sin dominio propio sirve:
# 1-2-3-4.sslip.io  (la IP con guiones), que también obtiene HTTPS automático.
DOMAIN=
PUBLIC_BASE_URL=https://

# Contraseñas de PostgreSQL (setup.sh las genera solas; no hace falta tocarlas).
DB_ADMIN_PASSWORD=
DB_PASSWORD=
# Clave de la aplicación: COPIA LA MISMA de Render (SECRET_KEY) para que sigan
# funcionando los buzones conectados, sesiones y datos cifrados.
SECRET_KEY=

LOG_LEVEL=INFO
ORKESTA_BOOTSTRAP_ORG_NAME=America Digital
ORKESTA_BOOTSTRAP_ADMIN_EMAIL=
ORKESTA_BOOTSTRAP_ADMIN_PASSWORD=

# Integraciones (copia los valores de Render).
SERPER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Respaldos diarios en S3 (opcional pero recomendado): nombre del bucket.
BACKUP_BUCKET=
